# Copy to .env (or set these in your host's dashboard). Never commit the real values.
PRODUCTION=1
SECRET_KEY=paste-a-long-random-string-here
ADMIN_USER=owner
ADMIN_PASSWORD=choose-a-strong-first-password
DATA_DIR=/data
FORCE_HTTPS=1
TRUST_PROXY=1
AUTO_BACKUP_HOURS=24
DEFAULT_COUNTRY_CODE=27

# Email for quote notifications (use your email provider's SMTP details)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hello@yourdomain.co.za
SMTP_PASSWORD=app-password-here
MAIL_FROM=Chef Amara <hello@yourdomain.co.za>
